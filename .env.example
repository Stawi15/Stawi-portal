# InsForge backend connection (copy to .env.local and fill in real values).
# Find both values in the InsForge dashboard under Install > API Keys.
VITE_INSFORGE_URL=https://your-project.region.insforge.app
VITE_INSFORGE_ANON_KEY=anon_your_anon_key

# Optional, temporary: skip the sign-in screen. When true, the portal signs in
# silently with the service account below (anyone who can open the portal can
# then edit content). Set to false to require normal sign-in.
VITE_DISABLE_AUTH=false
VITE_PORTAL_SERVICE_EMAIL=
VITE_PORTAL_SERVICE_PASSWORD=
